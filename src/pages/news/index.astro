---
import Base from '../../layouts/Base.astro';
import { getNews } from '../../lib/content';
const news = await getNews('news');
const blog = await getNews('blog');
const posts = [['News', news], ['Blog', blog]] as const;
---
<Base title="News & Blog" description="News and blog posts from OSiV.">
  <h1>News &amp; Blog</h1>
  <p class="intro">Announcements from the lab on the left, short posts that explain our research in plain language on the right.</p>
  <!-- To add a post: create a Markdown file in src/content/news/ (see the existing ones). No image yet? Leave `image` out and an empty slot shows. -->
  <div class="newsgrid">
    {posts.map(([label, list]) => (
      <section class:list={['newscol', label === 'Blog' && 'blogcol']}>
        <h2 class="colh">{label}</h2>
        {list.map((n) => {
          const d = n.data;
          const img = d.image ? <img src={d.image} alt="" loading="lazy" style={d.imagePosition ? `object-position:${d.imagePosition}` : undefined} /> : <span>image coming soon</span>;
          const slot = <div class:list={['ph', d.fig && 'fig', !d.image && 'empty']}>{img}</div>;
          return (
            <article class="post">
              {d.href ? <a class="nb" href={d.href}>{slot}</a> : slot}
              <div class="txt">
                <span class="date">{d.label ?? d.date}</span>
                <h3>{d.href ? <a href={d.href}>{d.title}</a> : d.title}</h3>
                <p>{n.body}</p>
              </div>
            </article>
          );
        })}
      </section>
    ))}
  </div>
</Base>
