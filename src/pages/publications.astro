---
import Base from '../layouts/Base.astro';
import PubItem from '../components/PubItem.astro';
import { getPublications } from '../lib/content';
const pubs = await getPublications({ listedOnly: true });
const accepted = pubs.filter((p) => p.data.status === 'accepted');
const later = pubs.filter((p) => p.data.status !== 'accepted');
---
<Base title="Publications" description="Publications by OSiV members.">
  <h1>Publications</h1>
  <p class="intro">
    Papers by OSiV members and our partner group ViSO. Vietnamese-language articles are listed with English titles.
    Author lists, PDFs and DOIs for journal articles are being collected and will be added soon.
  </p>
  <div class="filters" id="pubfilter">
    <button data-f="all" class="on">all</button>
    <button data-f="conf">international conferences</button>
    <button data-f="journal">Vietnamese journals</button>
    <button data-f="review">under review</button>
  </div>
  <section class="pubgroup"><div class="yr">2026</div><ul class="pblt">{accepted.map((p) => <PubItem pub={p} />)}</ul></section>
  <section class="pubgroup"><div class="yr">Under review &amp; in preparation</div><ul class="pblt">{later.map((p) => <PubItem pub={p} />)}</ul></section>
</Base>

<script>
  const bar = document.getElementById('pubfilter');
  bar?.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest('button');
    if (!b) return;
    bar.querySelectorAll('button').forEach((x) => x.classList.toggle('on', x === b));
    const f = b.dataset.f ?? 'all';
    document.querySelectorAll<HTMLElement>('.pblt > li').forEach((li) => {
      li.style.display = f === 'all' || (li.dataset.kind ?? '').split(' ').includes(f) ? '' : 'none';
    });
    document.querySelectorAll<HTMLElement>('.pubgroup').forEach((g) => {
      const any = [...g.querySelectorAll<HTMLElement>('.pblt > li')].some((li) => li.style.display !== 'none');
      g.style.display = any ? '' : 'none';
    });
  });
</script>
